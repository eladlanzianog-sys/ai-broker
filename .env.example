ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stock_analysis
FINNHUB_API_KEY=

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
ALERT_MIN_CONFIDENCE=0.0

# Auto Scanner
WATCHLIST=AAPL,MSFT,GOOGL,NVDA,META,AMZN,TSLA,JPM,V,BRK-B
SCAN_HOUR=8
SCAN_MINUTE=0
SCAN_ONLY_ACTIONABLE=true

LOG_LEVEL=INFO

# IBKR Trading
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_TRADING_ENABLED=false
IBKR_RISK_PER_TRADE=1.0
IBKR_MAX_POSITION_PCT=0.20
IBKR_REWARD_RATIO=2.0
IBKR_MIN_CONFIDENCE=0.5
IBKR_ATR_MULTIPLIER=1.5

# Automation
AUTOMATION_MODE=advanced
AUTOMATION_MONITOR_INTERVAL=900
AUTOMATION_HEALTH_INTERVAL=3600
AUTOMATION_MAX_ERRORS_PER_DAY=20
AUTOMATION_POSITION_ALERT_PCT=-5.0
